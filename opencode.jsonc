{
  "$schema": "https://opencode.ai/config.json",

  // The Orchestrator coordinates the workflow. The five specialist agents run
  // as subagents in child sessions.
  "default_agent": "orchestrator",

  // Shared instructions are added to every session after AGENTS.md. Agent
  // definitions stay in .opencode/agents/ and are discovered automatically.
  "instructions": ["docs/workflow/feedback-contract.md"],

  // Permission policy. Rules are ordered and the last matching rule wins, so
  // this array reads deny -> allow -> ask -> deny: broad Git/GitHub denials
  // first, then read-only allows, then the ask rules for infrastructure,
  // hidden-command wrappers and paths outside the worktree, and finally the
  // credential-path and nested-write denials that must survive later rules.
  // Agent rules from .opencode/agents/*.md are appended after this list; the
  // Git Manager repeats the sensitive-path and human-only-merge denials after
  // its write allows for the same reason. RTK is a CLI proxy: "rtk git ..." and
  // "rtk gh ..." are pass-throughs to git/gh, the other rtk subcommands are
  // file/report tools, and "rtk test", "rtk err", "rtk summary",
  // "rtk bypass"/"rtk proxy" execute hidden commands.
  "permissions": [
    // a) Git and GitHub are denied by default, in plain and RTK form. Write
    //    operations belong to the Git Manager agent, which appends explicit
    //    allow rules. Last matching rule wins, so the read-only allows below
    //    re-enable inspection.
    { "action": "shell", "resource": "git *", "effect": "deny" },
    { "action": "shell", "resource": "gh *", "effect": "deny" },
    { "action": "shell", "resource": "rtk git *", "effect": "deny" },
    { "action": "shell", "resource": "rtk gh *", "effect": "deny" },

    // b) Read-only Git inspection stays available in both forms.
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git ls-tree*", "effect": "allow" },
    { "action": "shell", "resource": "git blame*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git blame*", "effect": "allow" },
    { "action": "shell", "resource": "git grep*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git grep*", "effect": "allow" },
    { "action": "shell", "resource": "git describe*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git describe*", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git shortlog*", "effect": "allow" },
    { "action": "shell", "resource": "git merge-base*", "effect": "allow" },
    { "action": "shell", "resource": "rtk git merge-base*", "effect": "allow" },

    // b) Read-only GitHub inspection stays available in both forms.
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh pr diff*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh pr list*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh issue list*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh workflow view*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh workflow list*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "gh release list*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gh release list*", "effect": "allow" },

    // c) RTK file and report tools condense output without hiding the executed
    //    command. Path constraints are added by the ask rules below.
    { "action": "shell", "resource": "rtk read*", "effect": "allow" },
    { "action": "shell", "resource": "rtk smart*", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep*", "effect": "allow" },
    { "action": "shell", "resource": "rtk rg*", "effect": "allow" },
    { "action": "shell", "resource": "rtk ast-grep*", "effect": "allow" },
    { "action": "shell", "resource": "rtk find*", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls*", "effect": "allow" },
    { "action": "shell", "resource": "rtk tree*", "effect": "allow" },
    { "action": "shell", "resource": "rtk wc*", "effect": "allow" },
    { "action": "shell", "resource": "rtk diff*", "effect": "allow" },
    { "action": "shell", "resource": "rtk log*", "effect": "allow" },
    { "action": "shell", "resource": "rtk json*", "effect": "allow" },
    { "action": "shell", "resource": "rtk deps*", "effect": "allow" },
    { "action": "shell", "resource": "rtk gain*", "effect": "allow" },
    { "action": "shell", "resource": "rtk methods*", "effect": "allow" },

    // Go quality toolchain. Plain and filtered runs below; the project has no
    // gofmt-only or vendored build steps that need broader writes.
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "govulncheck*", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint*", "effect": "allow" },
    { "action": "shell", "resource": "jactionlint*", "effect": "allow" },

    // d) Infrastructure, cluster, cloud, database and network tools require
    //    approval, in plain and RTK form.
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "rtk docker *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "rtk kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "oc *", "effect": "ask" },
    { "action": "shell", "resource": "rtk oc *", "effect": "ask" },
    { "action": "shell", "resource": "aws *", "effect": "ask" },
    { "action": "shell", "resource": "rtk aws *", "effect": "ask" },
    { "action": "shell", "resource": "psql *", "effect": "ask" },
    { "action": "shell", "resource": "rtk psql *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "rtk wget *", "effect": "ask" },

    // e) Toolchains the project does not use are denied in both forms.
    { "action": "shell", "resource": "pnpm *", "effect": "deny" },
    { "action": "shell", "resource": "rtk pnpm *", "effect": "deny" },
    { "action": "shell", "resource": "dotnet *", "effect": "deny" },
    { "action": "shell", "resource": "rtk dotnet *", "effect": "deny" },

    // f) rtk test, rtk err and rtk summary execute hidden commands and are
    //    denied. The Go quality tools may run through rtk test filters; these
    //    narrow allows sit before the nested-write denials below, so compound
    //    commands that also contain a write still resolve to deny. rtk bypass
    //    and rtk proxy are the explicit escape hatches and require approval.
    { "action": "shell", "resource": "rtk test*", "effect": "deny" },
    { "action": "shell", "resource": "rtk err*", "effect": "deny" },
    { "action": "shell", "resource": "rtk summary*", "effect": "deny" },
    { "action": "shell", "resource": "rtk test *govulncheck*", "effect": "allow" },
    { "action": "shell", "resource": "rtk test *golangci-lint*", "effect": "allow" },
    { "action": "shell", "resource": "rtk test *jactionlint*", "effect": "allow" },
    { "action": "shell", "resource": "rtk bypass*", "effect": "ask" },
    { "action": "shell", "resource": "rtk proxy*", "effect": "ask" },

    // g) RTK commands that touch paths outside the worktree require approval.
    //    A generic "rtk * /*" rule is deliberately not used: it would ask for
    //    every absolute path, including harmless repository-internal ones.
    { "action": "shell", "resource": "rtk * ~*", "effect": "ask" },
    { "action": "shell", "resource": "rtk * $HOME*", "effect": "ask" },
    { "action": "shell", "resource": "rtk * ${HOME}*", "effect": "ask" },
    { "action": "shell", "resource": "rtk * /Users/*", "effect": "ask" },
    { "action": "shell", "resource": "rtk * /home/*", "effect": "ask" },
    { "action": "shell", "resource": "rtk * ../*", "effect": "ask" },

    // h) Credential and secret locations are never read or written. The
    //    external_directory gate asks for approval first and then denies every
    //    credential location; read and edit deny the same paths; shell command
    //    strings get leading-wildcard mirrors so the same locations cannot be
    //    reached through command arguments. The personal OpenCode
    //    configuration stays local and is not hard-forbidden: read, edit,
    //    external access and shell command arguments are on approval only.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.netrc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/log/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/Keychains/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "ask" },

    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/log/*", "effect": "deny" },
    { "action": "read", "resource": "~/Library/Keychains/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/*", "effect": "ask" },

    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/log/*", "effect": "deny" },
    { "action": "edit", "resource": "~/Library/Keychains/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/*", "effect": "ask" },

    // Environment files carry credentials on disk. Deny reads and edits of
    // every *.env and *.env.* path, then re-enable an `.env.example` or
    // `*.env.example` template, if present.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Shell mirrors of the credential denials above, so command strings such
    // as "cat ~/.ssh/id_rsa" cannot bypass the file tools. The last mirror is
    // the personal OpenCode configuration: it asks, never denies, because the
    // owner requires that location to stay approval-only.
    { "action": "shell", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.config/gh/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.kube/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.docker/config.json*", "effect": "deny" },
    { "action": "shell", "resource": "*/.netrc*", "effect": "deny" },
    { "action": "shell", "resource": "*/.git-credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*/.npmrc*", "effect": "deny" },
    { "action": "shell", "resource": "*/.pypirc*", "effect": "deny" },
    { "action": "shell", "resource": "*/.local/share/opencode/auth.json*", "effect": "deny" },
    { "action": "shell", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "shell", "resource": "*/.local/share/opencode/log/*", "effect": "deny" },
    { "action": "shell", "resource": "*Library/Keychains/*", "effect": "deny" },
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*/.config/opencode/*", "effect": "ask" },

    // i) Defence in depth: write commands hidden inside wrapper or compound
    //    commands are denied in every scanner-produced command string. The
    //    Git Manager's later allow rules still win for direct commands; the
    //    validator proves both.
    { "action": "shell", "resource": "*git add *", "effect": "deny" },
    { "action": "shell", "resource": "*git commit *", "effect": "deny" },
    { "action": "shell", "resource": "*git push *", "effect": "deny" },
    { "action": "shell", "resource": "*git merge *", "effect": "deny" },
    { "action": "shell", "resource": "*git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "*git reset *", "effect": "deny" },
    { "action": "shell", "resource": "*gh pr create*", "effect": "deny" },
    { "action": "shell", "resource": "*gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "*gh api *", "effect": "deny" },

    // gh api and pull-request merges stay denied project-wide even if a later
    // rule category ever broadens the surrounding gh patterns.
    { "action": "shell", "resource": "gh api*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" }
  ],

  // Optional project-local model assignments. Uncomment and edit individual
  // entries when this repository needs a pinned model. Unset agents inherit
  // their model from the global OpenCode configuration or the parent session.
  //
  // "agents": {
  //   "orchestrator": { "model": "provider/model#variant" },
  //   "planner": { "model": "provider/model#variant" },
  //   "reviewer": { "model": "provider/model#variant" },
  //   "implementer": { "model": "provider/model#variant" },
  //   "tester": { "model": "provider/model#variant" },
  //   "git-manager": { "model": "provider/model#variant" }
  // }
}
